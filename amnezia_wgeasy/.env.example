# ============================================
# AMNEZIA WG EASY - Конфигурация окружения
# ============================================

# Основные настройки
# ------------------
# Порт для WireGuard (UDP)
WG_PORT=ваш порт

# Порт для веб-интерфейса (TCP)
PORT=ваш порт для вэб

# Хеш пароля для входа в веб-интерфейс
# Сгенерируйте с помощью: echo "ваш_пароль" | shasum -a 256 | cut -d ' ' -f1
PASSWORD_HASH=ваш хэш

# ============================================
# Дополнительные настройки (опционально)
# ============================================

# Настройки контейнера
# --------------------
# TZ=Europe/Moscow
# LOG_LEVEL=info

# Настройки сети
# --------------
# WG_HOST=ваш-домен-или-ip
# WG_SUBNET=10.8.0.0/24
# WG_ALLOWED_IPS=0.0.0.0/0

# Настройки DNS
# -------------
# WG_DNS=1.1.1.1

# Безопасность
# ------------
# WG_PERSISTENT_KEEPALIVE=25
# WG_MTU=1420