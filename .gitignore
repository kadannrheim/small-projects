# Файлы окружения (содержат токены ботов)
.env                    # Основной файл с секретами
.env.local              # Локальные переопределения
.env.*.local            # Все локальные варианты
*.env                   # Любые env файлы
.env.production         # Продакшн
.env.staging            # Стейджинг

# Директории с секретами
secrets/                # Директория с секретами
keys/                   # SSH ключи и сертификаты
folder_with_sshkey/     # Папка с SSH ключами

# Файлы ключей и сертификатов
*.key                   # Приватные ключи
*.pem                   # PEM сертификаты (если приватные)
*.crt                   # CRT сертификаты (если приватные)
*.pub                   # Публичные ключи (обычно безопасно, но лучше игнорировать)
