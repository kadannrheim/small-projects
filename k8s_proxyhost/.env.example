# =============================================================================
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Container ---
CONTAINER_NAME=k8s-proxyhost
SSH_PORT=2222
TIMEZONE=Europe/Moscow

# --- Host paths (mounted into the container) ---
# Folder must contain file: authorized_keys (your SSH public key)
SSH_KEYS_PATH=./folder_with_sshkey
# Path to a kubeconfig *file* (not a directory)
KUBECONFIG_PATH=./kubeconfig/config
SCRIPTS_PATH=./scripts
MANIFESTS_PATH=./manifests

# --- GitLab Runner (shell executor only) ---
# Create a runner in GitLab UI → Executor: Shell → copy authentication token (glrt-...)
GITLAB_URL=https://gitlab.com
GITLAB_RUNNER_TOKEN_SHELL=glrt-xxxxxxxxxxxxxxxxxxxx
GITLAB_RUNNER_NAME=shell-on-k8s-proxyhost
GITLAB_RUNNER_TAGS=shell,linux
GITLAB_RUNNER_RUN_UNTAGGED=true
GITLAB_RUNNER_LOCKED=false
# Set true once to wipe volume config and re-register, then set back to false
FORCE_REREGISTER=false
# Leave empty — docker executor is NOT supported by this image
# GITLAB_RUNNER_TOKEN_DOCKER=

# --- Image build (optional pins / lighter image) ---
INSTALL_K9S=true
INSTALL_HELM=true
KUBECTL_VERSION=v1.30.4
HELM_VERSION=v3.15.4
K9S_VERSION=v0.32.5
GITLAB_RUNNER_VERSION=v17.3.1

# --- Resources (keep modest to avoid host CPU thrash) ---
CPU_LIMIT=0.5
MEMORY_LIMIT=512m
MEMORY_RESERVATION=128m
