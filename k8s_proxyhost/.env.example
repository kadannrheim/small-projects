# .env.example - КОММИТИТЬ В GIT!
# Скопируйте этот файл как .env и заполните своими значениями

# ============================================
# ОБЩАЯ КОНФИГУРАЦИЯ
# ============================================
CONTAINER_NAME=k8s-proxyhost
SSH_PORT=2222
TIMEZONE=UTC

# ============================================
# SSH КЛЮЧИ
# ============================================
SSH_KEYS_PATH=./folder_with_sshkey

# ============================================
# KUBERNETES КОНФИГ
# ============================================
KUBECONFIG_PATH=./kubeconfig/config

# ============================================
# GITLAB RUNNER ТОКЕНЫ (ЗАПОЛНИТЕ СВОИМИ!)
# ============================================
GITLAB_RUNNER_TOKEN_SHELL=your_shell_runner_token_here
GITLAB_RUNNER_TOKEN_DOCKER=your_docker_runner_token_here
GITLAB_URL=https://gitlab.com

# ============================================
# РЕСУРСЫ
# ============================================
CPU_LIMIT=0.8
MEMORY_LIMIT=1G
CPU_RESERVATION=0.2
MEMORY_RESERVATION=256M

# ============================================
# DOCKER НАСТРОЙКИ
# ============================================
USE_HOST_DOCKER=true