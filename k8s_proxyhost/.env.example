# =============================================================================
# Скопируйте в .env и заполните реальными значениями. .env в Git НЕ коммитьте.
# =============================================================================

# --- Контейнер ---
CONTAINER_NAME=k8s-proxyhost
SSH_PORT=2222
TIMEZONE=Europe/Moscow

# --- Пути на хосте (монтируются в контейнер) ---
# В папке должен быть файл authorized_keys (ваш публичный SSH-ключ)
SSH_KEYS_PATH=./folder_with_sshkey
# Путь к файлу kubeconfig (не к каталогу)
KUBECONFIG_PATH=./kubeconfig/config
SCRIPTS_PATH=./scripts
MANIFESTS_PATH=./manifests

# --- GitLab Runner (только shell executor) ---
# В UI: Create runner → Executor: Shell → теги/locked там же → скопируйте токен (glrt-...)
# Не переиспользуйте токен после register — при сбое создайте новый runner.
GITLAB_URL=https://gitlab.com
GITLAB_RUNNER_TOKEN_SHELL=glrt-xxxxxxxxxxxxxxxxxxxx
GITLAB_RUNNER_NAME=shell-on-k8s-proxyhost
# Теги / run-untagged / locked настраиваются в UI GitLab (для glrt- register их отклоняет)
# Значения ниже — только для вашей памятки, register их не читает
GITLAB_RUNNER_TAGS=shell,linux
GITLAB_RUNNER_RUN_UNTAGGED=true
GITLAB_RUNNER_LOCKED=false
# Один раз true — сбросить volume-конфиг и перерегистрировать, потом снова false
FORCE_REREGISTER=false
# Оставьте пустым / закомментированным — docker executor в образе НЕ поддерживается
# GITLAB_RUNNER_TOKEN_DOCKER=

# --- Сборка образа (пины версий / облегчение) ---
# Для более лёгкого образа: INSTALL_K9S=false (и при желании INSTALL_HELM=false)
INSTALL_K9S=true
INSTALL_HELM=true
KUBECTL_VERSION=v1.30.4
HELM_VERSION=v3.15.4
K9S_VERSION=v0.32.5
GITLAB_RUNNER_VERSION=v17.3.1

# --- Ресурсы (скромные лимиты, чтобы не грузить CPU хоста) ---
CPU_LIMIT=0.5
MEMORY_LIMIT=512m
MEMORY_RESERVATION=128m
